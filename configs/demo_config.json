{
  "model":      "models/one_beacon630.pt",
  "crop_model": "models/best_crop.pt",
  "conf":       0.5,
  "display":    true,
  "true_dist":  4.572,
  "save":       false,
  "log":        true,
  "save_crops": true,
  "save_det_images": true,
  "save_frames":     false,
  "video":      null,
  "ros_video":  "/workspaces/isaac_ros-dev/isaac_ros_assets/beacon_videos/blink_red.mp4",

  "topics": {
    "drone_pose":     null,
    "gps_origin":     null,
    "detections_pub": "/seabird/beacon_detections",
    "aruco_pub":      "/seabird/aruco_ground_truth"
  },

  "paths": {
    "scripts_dir": "~/seabird/scripts",
    "dataset_dir": "~/seabird_dataset",
    "logs_dir":    "~/seabird/logs",
    "px4_dir":     "~/seabird/PX4-Autopilot",
    "assets_dir":  "~/seabird/assets"
  },

  "isaac": {
    "drone_prim_path":  "/World/Iris",
    "drone_body_path":  "/World/Iris/body",
    "camera_prim_path": "/hires_front_small_color"
  },

  "camera": {
    "focal_length_mm":  2.1,
    "h_aperture_mm":    6.0,
    "v_aperture_mm":    4.5,
    "clipping_near":    0.1,
    "clipping_far":   200.0,
    "img_w":           640,
    "img_h":           480,
    "mount_offset_xyz": [0.30, 0.0, 0.05],
    "pitch_deg":        15.0
  },

  "drone_spawn": {
    "position":  [0.0, -8.0, 2.5],
    "quat_wxyz": [0.707, 0.0, 0.0, -0.707]
  },

  "px4": {
    "connection_type": "tcpin",
    "takeoff_alt_m":   1.25
  },

  "labeler": {
    "save_every_n": 10,
    "max_frames":   2000,
    "debug_mode":   true,
    "min_bbox_px":  6
  },

  "aruco": {
    "enabled":          false,
    "dictionary":       "DICT_4X4_50",
    "marker_size_m":    0.089,
    "calibration_file": "/workspace/ArucoMarkerDetection/camera_calibration.npz"
  },

  "detection": {
    "depth_source": "topic",
    "imgsz": 640,
    "red_threshold":    0.40,
    "winner_threshold": 0.25,
    "red_hue_high":     30,
    "blink_min_edge_gap": 0.35,
    "blink_min_data_sec": 3.0,
    "blue_hue_center":  105,
    "blue_hue_half":    10,
    "red_hue_low":      110,
    "blink_max_ioi_ratio": 2.0
  }
}
