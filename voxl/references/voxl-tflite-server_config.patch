+cv::Mat ModelHelper::resize_to_model_input(const uint8_t *frame, int channels)
+{
+    int type = (channels == 3) ? CV_8UC3 : CV_8UC1;
+    uint8_t *dst = letterbox ? letterbox_scratch : resize_output;
+
+    if (channels == 3)
+        mcv_resize_8uc3_image(frame, dst, &map);
+    else
+        mcv_resize_image(frame, dst, &map);
+
+    cv::Mat model_input(model_height, model_width, type, (uchar *)resize_output);
+    if (letterbox)
+    {
+        cv::Mat scaled(map.h_out, map.w_out, type, (uchar *)letterbox_scratch);
+        scaled.copyTo(model_input(cv::Rect(pad_x, pad_y, map.w_out, map.h_out)));
+    }
+    return model_input;
+}
+
+cv::Rect ModelHelper::model_box_to_frame(float xc, float yc, float w, float h)
+{
+    float x1 = ((xc - 0.5f * w) * model_width - pad_x) / scale_x;
+    float y1 = ((yc - 0.5f * h) * model_height - pad_y) / scale_y;
+    float x2 = ((xc + 0.5f * w) * model_width - pad_x) / scale_x;
+    float y2 = ((yc + 0.5f * h) * model_height - pad_y) / scale_y;
+
+    // letterboxed boxes can reach into the padding, i.e. outside the frame
+    x1 = std::max(0.0f, std::min(x1, (float)(input_width - 1)));
+    y1 = std::max(0.0f, std::min(y1, (float)(input_height - 1)));
+    x2 = std::max(0.0f, std::min(x2, (float)(input_width - 1)));
+    y2 = std::max(0.0f, std::min(y2, (float)(input_height - 1)));
+
+    return cv::Rect(cv::Point((int)x1, (int)y1), cv::Point((int)x2, (int)y2));
+}
